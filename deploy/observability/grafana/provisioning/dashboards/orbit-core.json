            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,surface) (rate(orbit_core_http_request_duration_seconds_bucket{job=\"orbit-core\"}[$__rate_interval])))",
          "legendFormat": "{{surface}}",
          "instant": false,
          "range": true
        }
      ]
    },
