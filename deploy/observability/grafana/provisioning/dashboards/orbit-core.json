        {
          "refId": "B",
          "expr": "((up{job=\"orbit-core\"} == 1) * 0) unless on() (60 * sum by (surface,code,route) (rate(orbit_core_http_requests_total{job=\"orbit-core\",code=~\"[45]..\"}[$__rate_interval])) > 0)",
          "legendFormat": "无错误",
          "instant": false,
          "range": true
