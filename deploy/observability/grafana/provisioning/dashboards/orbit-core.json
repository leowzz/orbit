      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Core 和 Inbox 的应用表，每分钟读取一次。超过 3 分钟未更新的快照不展示。行数包含保留的历史记录。",
      "targets": [
        {
          "refId": "A",
          "expr": "orbit_core_sqlite_table_rows{job=\"orbit-core\"} and on(job,instance,database) (time() - orbit_core_sqlite_table_rows_last_success_timestamp_seconds{job=\"orbit-core\"} < 180)",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "service": true
            },
            "indexByName": {
              "database": 0,
              "table": 1,
              "Value": 2
            },
            "renameByName": {
              "database": "数据库",
              "table": "表",
              "Value": "行数"
            }
          }
        }
      ],
