        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (surface) (rate(orbit_core_http_requests_total{job=\"orbit-core\"}[$__rate_interval]))",
          "legendFormat": "{{surface}}",
          "instant": false,
          "range": true
