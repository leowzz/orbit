      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "service": true
            },
            "renameByName": {
              "agent_id": "Worker",
              "host_label": "主机",
              "device": "设备",
              "model": "模型",
              "status": "最近状态",
              "connection": "连接状态"
            }
          }
