          "expr": "sum by (agent_id) (rate(orbit_audio_processing_seconds_total{job=\"orbit-core\",agent_id=~\"$worker\"}[$__rate_interval])) / sum by (agent_id) (rate(orbit_audio_processed_audio_seconds_total{job=\"orbit-core\",agent_id=~\"$worker\"}[$__rate_interval]))",
          "legendFormat": "{{agent_id}} RTF",
