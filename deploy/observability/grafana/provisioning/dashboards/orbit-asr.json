      "targets": [
        {
          "expr": "sum(orbit_audio_worker_jobs{job=\"orbit-core\",agent_id=~\"$worker\",stage=~\"queued|processing\"})",
          "legendFormat": "待处理",
          "refId": "A",
          "range": true
        }
