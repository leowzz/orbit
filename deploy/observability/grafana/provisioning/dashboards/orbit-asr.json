          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 7,
      "title": "消费速度 / 分钟",
      "description": "Core 首次接受结果的速率；重复 MQTT 消息不重复计数。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "暂无数据",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(orbit_audio_results_total{job=\"orbit-core\",agent_id=~\"$worker\"}[$__rate_interval])) * 60",
          "legendFormat": "结果 / 分钟",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 8,
      "title": "平均单段处理耗时",
      "description": "Worker 上报的最后一次推理耗时；没有新结果时显示暂无数据。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "暂无数据",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(orbit_audio_processing_seconds_total{job=\"orbit-core\",agent_id=~\"$worker\"}[$__rate_interval])) / sum(rate(orbit_audio_results_total{job=\"orbit-core\",agent_id=~\"$worker\"}[$__rate_interval]))",
          "legendFormat": "处理耗时",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "orientation": "auto"
      }
    },
