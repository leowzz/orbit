{
  "name": "@orbit/core-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": "node --experimental-strip-types --test src/*.test.ts box.test.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src e2e/*.ts playwright.config.ts box.test.cjs vite.config.ts package.json tsconfig.json",
    "format:check": "prettier --check src e2e/*.ts playwright.config.ts box.test.cjs vite.config.ts package.json tsconfig.json",
    "test:browser": "pnpm build && playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
